<mvc:View
    controllerName="zob.zfiob52.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="page" title="Posting Periods: Specify Time Intervals" showHeader="true" showNavButton="false">

        <customHeader>
            <Bar
                height="56px"
                style="padding-left:12px; padding-right:12px;"
            >
                <contentLeft>
                    <Image
                        src="images/jindal.png"
                        height="35px"
                        width="51px"
                        alt="Logo"
                        style="margin-right:12px;"
                    />
                </contentLeft>
                <contentMiddle>
                    <Title
                        text="Posting Periods: Specify Time Intervals"
                        level="H1"
                        style="line-height:40px; font-weight:700; font-size:1.8rem;"
                    />
                </contentMiddle>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiSmallMargin" id="rootVBox">

                <!-- Table now always visible -->
                <VBox id="tableContainer">

                    <List items="{path: 'ob52>/rows'}">
                        <CustomListItem>
                            <VBox class="sapUiSmallMargin" style="border:1px solid #ccc; padding:12px; border-radius:4px;">
                                <Title text="{ob52>A}" level="H5" class="sapUiSmallMarginBottom"/>

                                <!-- From Account -->
                                <VBox class="sapUiSmallMarginBottom">
                                    <HBox alignItems="Center" fitContainer="true" justifyContent="Start">
                                        <Label text="From Account:" width="140px"/>
                                        <Input value="{ob52>FromAcc}" width="100%" maxWidth="220px"/>
                                    </HBox>
                                    <FormattedText 
                                        htmlText="&lt;span style='font-style:italic;'&gt;(This is what it is!)&lt;/span&gt;"
                                        class="fieldDescriptionMobile"
                                        wrapping="false"
                                    />
                                </VBox>

                                <!-- To Account -->
                                <HBox alignItems="Center" fitContainer="true" justifyContent="Start" class="sapUiSmallMarginBottom">
                                    <Label text="To Account:" width="140px"/>
                                    <Input value="{ob52>ToAcc}" width="100%" maxWidth="220px"/>
                                </HBox>

                                <!-- From Per 1 -->
                                <HBox alignItems="Center">
                                    <Label text="From Per 1:" width="140px"/>
                                    <StepInput 
                                        class="customStepInput"
                                        width="80px"
                                        min="1" 
                                        max="16"
                                        value="{ob52>FromPer1}" 
                                        change="onPeriodChange"
                                        textAlign="Center"
                                    />
                                    <Text 
                                        text="{path: 'ob52>FromPer1', formatter: '.formatPeriodText'}"
                                        class="helperText sapUiSmallMarginBegin"
                                        wrapping="false"
                                    />
                                </HBox>

                                <!-- Year 1 -->
                                <HBox alignItems="Center">
                                    <Label text="Year 1:" width="140px"/>
                                    <DatePicker 
                                        value="{ob52>Year1}" 
                                        displayFormat="yyyy" 
                                        valueFormat="yyyy" 
                                        width="80px"
                                        change="onYearChange"
                                    />
                                </HBox>

                                <!-- To Per 1 -->
                                <HBox alignItems="Center">
                                    <Label text="To Per 1:" width="140px"/>
                                    <StepInput 
                                        class="customStepInput"
                                        width="80px"
                                        min="1" 
                                        max="16"
                                        value="{ob52>ToPer1}" 
                                        change="onPeriodChange"
                                        textAlign="Center"
                                    />
                                    <Text 
                                        text="{path: 'ob52>ToPer1', formatter: '.formatPeriodText'}"
                                        class="helperText sapUiSmallMarginBegin"
                                        wrapping="false"
                                    />
                                </HBox>

                                <!-- Year 2 -->
                                <HBox alignItems="Center">
                                    <Label text="Year 2:" width="140px"/>
                                    <Input value="{ob52>Year2}" width="80px"/>
                                </HBox>

                                <!-- From Per 2 -->
                                <HBox alignItems="Center">
                                    <Label text="From Per 2:" width="140px"/>
                                    <StepInput 
                                        class="customStepInput"
                                        width="80px"
                                        min="1" 
                                        max="16"
                                        value="{ob52>FromPer2}" 
                                        change="onPeriodChange"
                                        textAlign="Center"
                                    />
                                    <Text 
                                        text="{path: 'ob52>FromPer2', formatter: '.formatPeriodText'}"
                                        class="helperText sapUiSmallMarginBegin"
                                        wrapping="false"
                                    />
                                </HBox>

                                <!-- Year 3 -->
                                <HBox alignItems="Center">
                                    <Label text="Year 3:" width="140px"/>
                                    <Input value="{ob52>Year3}" width="80px"/>
                                </HBox>

                                <!-- To Per 2 -->
                                <HBox alignItems="Center">
                                    <Label text="To Per 2:" width="140px"/>
                                    <StepInput 
                                        class="customStepInput"
                                        width="80px"
                                        min="1" 
                                        max="16"
                                        value="{ob52>ToPer2}" 
                                        change="onPeriodChange"
                                        textAlign="Center"
                                    />
                                    <Text 
                                        text="{path: 'ob52>ToPer2', formatter: '.formatPeriodText'}"
                                        class="helperText sapUiSmallMarginBegin"
                                        wrapping="false"
                                    />
                                </HBox>

                                <!-- Year 4 -->
                                <HBox alignItems="Center">
                                    <Label text="Year 4:" width="140px"/>
                                    <Input value="{ob52>Year4}" width="80px"/>
                                </HBox>

                                <!-- Auth Group -->
                                <HBox alignItems="Center" fitContainer="true" justifyContent="Start" class="sapUiSmallMarginTop">
                                    <Label text="Auth Group:" width="140px"/>
                                    <Input value="{ob52>AuthGrp}" width="100%" maxWidth="220px"/>
                                </HBox>

                            </VBox>
                        </CustomListItem>
                    </List>

                </VBox>
            </VBox>
        </content>

        <footer>
            <Toolbar class="stickyFooter">
                <Button text="Back" press="onNavBack"/>
                <ToolbarSpacer/>
                <Button text="Update" type="Emphasized" press="onUpdate"/>
            </Toolbar>
        </footer>

    </Page>
</mvc:View>
