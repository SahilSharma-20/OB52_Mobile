<mvc:View
    controllerName="zob.zfiob52.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="homePage" showHeader="true" showNavButton="false">

        <customHeader>
    <Bar
        height="56px" 
        style="padding-left:12px; padding-right:12px;"
    >
        <contentLeft>
            <Image
                src="images/jindal.png"
                height="35px"
                width="100px"
                alt="Logo"
                style="margin-right:12px;" 
            />
        </contentLeft>
        <contentMiddle>
            <Title
                text="Posting Periods"
                level="H1"
                style="line-height:40px; font-weight:700; font-size:1.8rem;" 
            />
        </contentMiddle>
    </Bar>
</customHeader>


        <content>
            <VBox class="sapUiSmallMargin">

                <!-- Input + Button section (mobile friendly) -->
                <VBox class="sapUiSmallMarginBottom">

                    <Label text="Posting Period Variant:" />

                    <HBox
                        wrap="Wrap"
                        alignItems="Center"
                        class="sapUiTinyMarginTop">

                        <Input
                            id="postingPeriodInput"
                            width="200px"
                            submit="onSubmit"
                        />

                        <Button
                            text="Submit"
                            press="onSubmit"
                            type="Emphasized"
                            class="sapUiSmallMarginBegin"
                        />
                    </HBox>

                </VBox>

            </VBox>
        </content>

    </Page>

</mvc:View>
